# --- backend (export these or put them in your process manager) ---
PYTHONPATH=.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=0                 # set 1 when served over HTTPS
# SETUP_TOKEN=                  # optional fixed first-run token; otherwise a random one is printed once at API start
WORKER_PORT=8765                # localhost-only API <-> gate worker link (authkey in data/worker.key, mode 0600)
ENROLL_REQUIRE_LIVENESS=0       # 1 = refuse camera enrollment while PAD is not READY
PAD_PROVIDER=cpu                # cpu | a label printed by `python tools/pad_eval.py --benchmark`
ATTENDANCE_DB=                  # optional override of data/attendance_system.db
# API_DOCS=1                    # expose /api/openapi.json for development only
